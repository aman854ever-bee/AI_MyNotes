<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- spike/capacitor-oauth: deep-link callback for the calendar
                 OAuth connect flow (Google/Microsoft via Supabase). Opened
                 by lib/capacitorAuth.ts's Custom Tab redirect, handled by
                 the appUrlOpen listener registered in App.tsx. Must also be
                 added to Supabase Dashboard -> Authentication -> URL
                 Configuration -> Redirect URLs: mynotes://oauth-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mynotes" android:host="oauth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice notes and meeting recording (MeetingRecorder.tsx /
         VoiceRecorder.tsx) call the web getUserMedia({audio: true}) API
         inside the WebView. Without this declared here, Android can never
         grant microphone access to the app at runtime — regardless of what
         the user taps on any permission dialog — so getUserMedia() always
         rejects and both recorder screens immediately show "Microphone
         access was denied." Capacitor's Bridge (capacitor-android)
         forwards the WebView's getUserMedia permission request into a real
         Android runtime-permission prompt automatically; this manifest
         entry is the only piece that was missing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
