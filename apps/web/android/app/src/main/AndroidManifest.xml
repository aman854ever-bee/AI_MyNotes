<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- spike/capacitor-oauth: deep-link callback for the calendar
                 OAuth connect flow (Google/Microsoft via Supabase). Opened
                 by lib/capacitorAuth.ts's Custom Tab redirect, handled by
                 the appUrlOpen listener registered in App.tsx. Must also be
                 added to Supabase Dashboard -> Authentication -> URL
                 Configuration -> Redirect URLs: mynotes://oauth-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mynotes" android:host="oauth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice notes and meeting recording (MeetingRecorder.tsx /
         VoiceRecorder.tsx) call the web getUserMedia({audio: true}) API
         inside the WebView. Both of these are required, and it must be
         BOTH — see Capacitor 6's BridgeWebChromeClient.onPermissionRequest,
         which is what turns the WebView's permission request into a native
         Android one:

             if (resources.contains("...resource.AUDIO_CAPTURE")) {
                 permissionList.add(MODIFY_AUDIO_SETTINGS);
                 permissionList.add(RECORD_AUDIO);
             }

         It requests both, then grants the WebView request only if *every*
         permission in that batch came back granted:

             boolean granted = true;
             for (entry : isGranted.entrySet())
                 if (!entry.getValue()) granted = false;

         Android auto-denies any permission not declared in this manifest
         (no dialog — it just returns false), so declaring only RECORD_AUDIO
         means MODIFY_AUDIO_SETTINGS comes back false, the whole batch is
         treated as denied, Capacitor calls request.deny(), and
         getUserMedia() rejects — leaving both recorder screens stuck on
         "Microphone access was denied" even though the user tapped Allow.
         MODIFY_AUDIO_SETTINGS is a normal (non-dangerous) permission, so
         declaring it adds no extra prompt; it is granted at install time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
